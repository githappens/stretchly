# Code-signing / notarization config for the macOS deploy scripts
# (scripts/sign-mac.sh, scripts/deploy-local.sh).
#
# Copy to .env (gitignored) and fill in your own values.

# Developer ID Application identity, by NAME. The private key may live on a
# hardware token and not appear in `security find-identity` — signing still
# resolves it by this exact name.
#   security find-identity -v -p codesigning   # to see software-keychain identities
AppleCertName="Developer ID Application: Your Company (TEAMID)"

# notarytool keychain profile. Create it once with:
#   xcrun notarytool store-credentials notarytool-profile \
#     --apple-id you@example.com --team-id TEAMID
NotarizationKeychainProfileName=notarytool-profile
